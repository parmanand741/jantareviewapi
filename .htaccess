# This project root is not a web root: the container's DocumentRoot is public/,
# and docker/apache-vhost.conf denies the rest of /app. This file exists for the
# other case — a copy of the tree served straight from WAMP/XAMPP/`www/`, where
# none of that applies and the datastore credential would be one GET away.

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Repository metadata is never a download.
    RewriteRule "^\.(git|github|idea|vscode)(/|$)" - [F,L]
</IfModule>

# Credentials and environment files, by name so nothing under public/ is caught.
<FilesMatch "^(key\.txt|\.env|\.env\..*|service-account.*\.json|.*credentials.*\.json|.*_secrete\.txt|.*_secret\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
