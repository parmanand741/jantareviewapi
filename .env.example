# Review API secrets. Keep the real .env outside version control.
REVIEW_SPREADSHEET_ID=16kx-SLOOTe8tpMa8gZcZ8UeQVMIxGkxsnwQ4y9jDPgg
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/jantareview/service-account.json
REVIEW_CA_BUNDLE=C:/path/to/ca-bundle.crt
REVIEW_ENCRYPTION_KEY=
REVIEW_ADMIN_KEY=
TURNSTILE_SECRET=
REVIEW_EXPOSE_ERRORS=false
# Enable only in a local .env when Turnstile is unavailable.
TURNSTILE_BYPASS_FOR_LOCAL_DEV=false
TURNSTILE_USE_TEST_KEYS=false
TURNSTILE_TEST_SECRET=
APP_FORCE_HTTPS=true

# OTP mail delivery via the Mailjet transactional API (https://app.mailjet.com).
# OTP_FROM_EMAIL must be a sender verified in Mailjet (Senders & Domains).
# Keys: Mailjet → Account settings → API REST → default key/secret.
# The email address and OTP are never written to Google Sheets.
OTP_FROM_EMAIL=
OTP_FROM_NAME=JantaReview
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_DAY=3

# Comma-separated values. Do not use "*" for an API with credentials.
# Origins are matched exactly; never add a trailing slash.
REVIEW_ALLOWED_ORIGINS=http://reviews.local,http://localhost,http://127.0.0.1,http://localhost:5500,http://127.0.0.1:5500
# Turnstile siteverify reports the hostname of the page that rendered the widget
# (the frontend), not the host serving this API.
REVIEW_TURNSTILE_HOSTS=reviews.local,localhost,127.0.0.1
#
# Deployed example: frontend on https://jantareview.vercel.app and this API on
# https://jantareviewapi.byethost7.com
#   REVIEW_ALLOWED_ORIGINS=https://jantareview.vercel.app
#   REVIEW_TURNSTILE_HOSTS=jantareview.vercel.app
# A cross-site frontend also needs third-party session/CSRF cookies:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=None

# Thresholds and rate limits copied from updated/config/config.php.
REVIEW_UNPUBLISH_THRESHOLD=-15
REVIEW_RESCUE_THRESHOLD=-10
REVIEW_REPORT_CEILING=15
REVIEW_VOTE_COOLDOWN_SECONDS=60
REVIEW_REPORT_COOLDOWN_SECONDS=3600
REVIEW_SUBMIT_PER_HOUR=20
REVIEW_REPORT_PER_HOUR=30
REVIEW_PLAIN_MAX_LEN=500
REVIEW_ENCRYPTED_MAX_LEN=16000
REVIEW_PRODUCT_NAME_MAX_LEN=200
REVIEW_REPORT_REASON_MAX_LEN=500
REVIEW_GRIEVANCE_DESC_MIN_LEN=20
REVIEW_GRIEVANCE_DESC_MAX_LEN=500
REVIEW_PLATFORM_NAME=JantaReview
REVIEW_JURISDICTION=India
REVIEW_RETENTION_DAYS=90

# Optional operational settings.
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
REVIEW_STORAGE_PATH=
GRIEVANCE_OFFICER_NAME=Test Grievance Officer
GRIEVANCE_OFFICER_EMAIL=test@example.com
GRIEVANCE_OFFICER_PHONE=+91-0000000000
GRIEVANCE_OFFICER_ADDRESS=Test Address
GRIEVANCE_ACK_SLA_HOURS=24
GRIEVANCE_RESOLVE_SLA_DAYS=15
GRIEVANCE_PRIORITY_TAKEDOWN_HOURS=36
